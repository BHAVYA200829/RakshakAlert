# RakshakAlert scratch - Phase 1. No real secrets needed.
# Copy to .env if you want to change the demo admin login.
# Phase 1 sends NO real SMS and NO real email. All SMS is simulated.
FLASK_SECRET_KEY=change-me-to-a-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Push notifications (Extras): real Web Push needs VAPID keys.
# Without them, push subscriptions are stored and logged as
# SIMULATED_PUSH on broadcast. Generate keys with:
# python -c "from cryptography.hazmat.primitives.asymmetric import ec; print('see README')"
# and paste them here. No real push is sent in this demo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
